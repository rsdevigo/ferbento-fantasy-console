root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = crlf

[*.{cs,vb}]
indent_size = 4
charset = utf-8-bom

[*.{csproj,sln,slnx,xml,axaml,xshd}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
